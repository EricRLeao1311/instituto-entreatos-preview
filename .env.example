# Server only. Copy to .env locally; configure these as private variables on Vercel.
# Never point this project at the client's production domain/database.
APP_STAGE=preview
APP_ORIGIN=https://YOUR-TEST-PROJECT.vercel.app
BACKEND_ENABLED=false
SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service_role JWT alternative; leave blank when using SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
FORM_HASH_SECRET=
CRON_SECRET=
# Capture is the default. Send requires credentials AND an explicit test allowlist.
MAIL_MODE=capture
CONTACT_TO=
MAIL_FROM=
MAIL_ALLOWED_RECIPIENTS=
RESEND_API_KEY=
